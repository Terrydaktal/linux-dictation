# Copy to ~/.config/dictation/rambler.env (chmod 600) or export in your shell.
# Required to enable the Rambler (S3) live-streaming backend.
RAMBLER_S3_API_KEY=
RAMBLER_S3_ANDROID_CERT=
# Optional override (defaults to com.google.android.googlequicksearchbox):
# RAMBLER_S3_ANDROID_PACKAGE=com.google.android.googlequicksearchbox
